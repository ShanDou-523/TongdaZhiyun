<view class="page"><view class="eyebrow">ADMINISTRATION</view><view class="title">管理中心</view><view class="subtitle">客户、门店与数据，一处掌握。</view><view class="tabs"><view class="tab {{tab === 'users' ? 'active' : ''}}" data-tab="users" bindtap="tab">账户</view><view class="tab {{tab === 'stores' ? 'active' : ''}}" data-tab="stores" bindtap="tab">门店</view><view class="tab {{tab === 'services' ? 'active' : ''}}" data-tab="services" bindtap="tab">服务</view><view class="tab {{tab === 'banners' ? 'active' : ''}}" data-tab="banners" bindtap="tab">广告</view><view class="tab {{tab === 'database' ? 'active' : ''}}" data-tab="database" bindtap="tab">数据库</view><view class="tab {{tab === 'qrcode' ? 'active' : ''}}" data-tab="qrcode" bindtap="tab">入口码</view></view>
<block wx:if="{{tab === 'users'}}"><view class="card" wx:for="{{users}}" wx:key="_id"><view class="row"><text>{{item.nickname}}</text><view class="tag">{{item.roleName}}</view></view><view class="muted">{{item.phone}} · {{(item.park === '其它' && item.parkDetail) ? '其它·' + item.parkDetail : item.park}}</view><view class="meta">所属门店：{{item.storeId}} · {{item.enabled ? '正常' : '已停用'}}</view><button wx:if="{{item.role !== 'admin'}}" class="secondary" data-id="{{item._id}}" bindtap="editUser">编辑账户权限</button></view><view class="card" id="user-editor" wx:if="{{edit}}"><view class="section-title">编辑：{{edit.nickname}}</view><view class="label">角色</view><picker range="{{roleOptions}}" value="{{roleIndex}}" data-key="roleIndex" bindchange="select"><view class="field">{{roleOptions[roleIndex]}} ⌄</view></picker><view class="label">所属门店</view><picker range="{{stores}}" range-key="name" value="{{storeIndex}}" data-key="storeIndex" bindchange="select"><view class="field">{{stores[storeIndex].name}} ⌄</view></picker><view class="row label">启用账户<switch checked="{{edit.enabled}}" bindchange="userEnabled" color="#285c47"/></view><button class="primary" bindtap="saveUser" loading="{{busy}}" disabled="{{busy}}">保存权限</button><button class="secondary" bindtap="close">取消</button></view></block>
<block wx:if="{{tab === 'stores'}}"><view class="card row" wx:for="{{stores}}" wx:key="_id"><view><view>{{item.name}}</view><view class="meta">{{item._id}} · {{item.enabled ? '启用' : '停用'}}</view></view><button class="secondary small" data-id="{{item._id}}" bindtap="editStore">编辑</button></view><view class="card"><view class="row"><view class="section-title" style="margin:0">{{editingStore ? '编辑门店' : '新建门店'}}</view><view class="link" bindtap="newStore">清空</view></view><view class="label">门店编号（小写字母、数字等，2–24位）</view><input class="field" value="{{storeId}}" data-key="storeId" bindinput="input" maxlength="24" disabled="{{editingStore}}" placeholder="例如 main"/><view class="label">门店名称</view><input class="field" value="{{storeName}}" data-key="storeName" bindinput="input" maxlength="40"/><view class="row label">启用门店<switch checked="{{storeEnabled}}" bindchange="storeEnabled" color="#285c47"/></view><button class="primary" bindtap="saveStore" loading="{{busy}}" disabled="{{busy}}">保存门店</button></view></block>
<block wx:if="{{tab === 'services'}}"><view class="meta" style="margin:20rpx 0">这里的服务会显示在客户首页的服务列表中；停用后仅后台可见。</view><view class="card row" wx:for="{{services}}" wx:key="_id"><view><view>{{item.name}}</view><view class="meta">{{item.category === 'laundry' ? '衣物洗护' : '家政服务'}} · {{item.enabled ? '启用' : '停用'}}</view><view class="muted">{{item.description}}</view></view><view><button class="secondary small" data-id="{{item._id}}" bindtap="editService">编辑</button><button class="secondary small" data-id="{{item._id}}" bindtap="removeService">删除</button></view></view><view class="card"><view class="row"><view class="section-title" style="margin:0">{{editingService ? '编辑服务' : '新建服务'}}</view><view class="link" bindtap="newService">清空</view></view><view class="label">服务名称</view><input class="field" value="{{serviceName}}" data-key="serviceName" bindinput="input" maxlength="40" placeholder="例如 衣物洗护"/><view class="label">服务类别</view><picker range="{{categoryOptions}}" value="{{categoryIndex}}" data-key="categoryIndex" bindchange="select"><view class="field">{{categoryOptions[categoryIndex]}} ⌄</view></picker><view class="label">服务说明（60字以内）</view><input class="field" value="{{serviceDesc}}" data-key="serviceDesc" bindinput="input" maxlength="60" placeholder="一句话说明这项服务"/><view class="row label">启用服务<switch checked="{{serviceEnabled}}" bindchange="serviceEnabled" color="#285c47"/></view><button class="primary" bindtap="saveService" loading="{{busy}}" disabled="{{busy}}">保存服务</button></view></block>
<block wx:if="{{tab === 'banners'}}"><view class="meta" style="margin:20rpx 0">这里的广告会显示在客户端首页顶部轮播位（最多5条，权重大的排前面），保存后实时生效。支持上传设计同事制作的海报图片（≤10MB）或短视频（≤60MB、60秒内），也可纯文案投放。适合投放自有活动，例如新用户注册福利。</view><view class="card row" wx:for="{{banners}}" wx:key="_id"><view><view>{{item.title}}</view><view class="meta">权重 {{item.weight}} · {{item.mediaType === 'image' ? '海报图' : (item.mediaType === 'video' ? '视频' : '纯文案')}} · {{item.enabled ? '投放中' : '已停投'}}</view><view class="muted">{{item.subtitle}}</view></view><view><button class="secondary small" data-id="{{item._id}}" bindtap="editBanner">编辑</button><button class="secondary small" data-id="{{item._id}}" bindtap="removeBanner">删除</button></view></view><view class="card"><view class="row"><view class="section-title" style="margin:0">{{editingBanner ? '编辑广告' : '新建广告'}}</view><view class="link" bindtap="newBanner">清空</view></view><view class="label">广告标题（30字以内）</view><input class="field" value="{{bannerTitle}}" data-key="bannerTitle" bindinput="input" maxlength="30" placeholder="例如 新用户福利"/><view class="label">广告说明（60字以内）</view><input class="field" value="{{bannerSubtitle}}" data-key="bannerSubtitle" bindinput="input" maxlength="60" placeholder="例如 注册即领 10 元现金红包，3 万元额度送完即止"/><view class="label">广告素材（可选，海报图或短视频）</view><view wx:if="{{bannerMediaType === 'none'}}" class="media-empty" bindtap="chooseBannerMedia">＋ 上传图片 / 视频</view><block wx:else><image wx:if="{{bannerMediaType === 'image'}}" class="media-preview" src="{{bannerMedia}}" mode="aspectFill"/><video wx:else class="media-preview" src="{{bannerMedia}}" objectFit="cover" controls="{{false}}" show-center-play-btn="{{false}}"></video><view class="row" style="margin-top:16rpx"><button class="secondary small" bindtap="chooseBannerMedia">重新选择</button><button class="secondary small" bindtap="removeBannerMedia">移除素材</button></view></block><view class="label">排序权重（0–999，越大越靠前）</view><input class="field" type="number" value="{{bannerWeight}}" data-key="bannerWeight" bindinput="input"/><view class="row label">投放中<switch checked="{{bannerEnabled}}" bindchange="bannerEnabled" color="#285c47"/></view><button class="primary" bindtap="saveBanner" loading="{{busy}}" disabled="{{busy}}">保存广告</button></view></block>
<block wx:if="{{tab === 'database'}}"><picker range="{{tables}}" value="{{tableIndex}}" bindchange="table"><view class="field">集合：{{tables[tableIndex]}} ⌄</view></picker><view class="meta" style="margin:20rpx 0">只读查看，每页20条。用户会话密钥不对外展示；查看操作会记录审计日志。</view><view class="card" wx:for="{{rows}}" wx:key="_id"><text class="mono" selectable>{{item.json}}</text></view></block>
<block wx:if="{{tab === 'qrcode'}}"><view class="card"><view class="label">选择门店</view><picker range="{{stores}}" range-key="name" value="{{qrStore}}" data-key="qrStore" bindchange="select"><view class="field">{{stores[qrStore].name || '请先创建门店'}} ⌄</view></picker><view class="label">小程序版本</view><picker range="{{versions}}" value="{{versionIndex}}" data-key="versionIndex" bindchange="select"><view class="field">{{versions[versionIndex]}} ⌄</view></picker><view class="meta" style="margin-top:20rpx">扫码后进入注册/登录页；已登录用户进入首页。开发版及体验版需具备相应体验权限，正式版需先发布。</view><button class="primary" bindtap="qrcode" loading="{{busy}}" disabled="{{busy}}">生成门店入口码</button><image wx:if="{{qr}}" src="{{qr}}" mode="widthFix" class="qr" bindtap="preview"/><view wx:if="{{qr}}" class="meta">点击放大，长按保存二维码</view></view></block>
<view wx:if="{{loading}}" class="loading">正在加载…</view><view class="error" wx:if="{{error}}">{{error}}</view><button wx:if="{{more}}" class="secondary" bindtap="load">加载更多</button><view class="empty" wx:if="{{!loading && ((tab === 'users' && !users.length) || (tab === 'database' && !rows.length))}}">暂无记录</view></view>
