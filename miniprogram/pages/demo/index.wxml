<view class="page">
  <view class="eyebrow">YUANLIN · DEMO</view>
  <view class="title">先把流程走一遍</view>
  <view class="subtitle">选择一个身份，无需手机号授权或密码。</view>
  <view class="demo-note">本地演示 · 数据仅存于当前设备，可随时重置。聊天需要在同一设备切换身份查看，不会同步到其他手机。</view>
  <block wx:if="{{available}}">
    <view class="section-title">选择测试身份</view>
    <view class="card" wx:for="{{accounts}}" wx:key="_id">
      <view class="row"><view class="service-title">{{item.nickname}}</view><view class="tag">{{item.roleName}}</view></view>
      <view class="muted">{{item.storeName}}</view>
      <view class="danger" wx:if="{{!item.enabled}}">账户已停用，可通过管理员恢复</view>
      <button class="primary" bindtap="enter" data-id="{{item._id}}" disabled="{{busy || !item.enabled}}">以此身份进入 →</button>
    </view>
    <view class="section-title">试试新客户注册</view>
    <view class="card">
      <view class="muted">创建后自动以客户进入；切换门店身份可查看新注册提醒。</view>
      <view class="label">测试昵称</view><input class="field" value="{{nickname}}" bindinput="input" maxlength="24" placeholder="例如：测试客户小王"/>
      <view class="label">所属门店</view><picker range="{{stores}}" range-key="name" value="{{storeIndex}}" data-key="storeIndex" bindchange="select"><view class="field">{{stores.length ? stores[storeIndex].name : '暂无启用门店'}} ⌄</view></picker>
      <view class="label">所在园区</view><picker range="{{parks}}" value="{{parkIndex}}" data-key="parkIndex" bindchange="select"><view class="field">{{parks[parkIndex]}} ⌄</view></picker>
      <input wx:if="{{parks[parkIndex] === '其它'}}" class="field" value="{{parkDetail}}" bindinput="parkDetail" maxlength="20" placeholder="填写具体园区或楼栋"/>
      <view class="label">宿舍号（选填）</view><input class="field" value="{{dormRoom}}" maxlength="20" placeholder="例如：3栋502 / A-502" bindinput="dormRoom"/><view class="label">性别</view><picker range="{{genders}}" value="{{genderIndex}}" data-key="genderIndex" bindchange="select"><view class="field">{{genders[genderIndex]}} ⌄</view></picker>
      <button class="primary" bindtap="register" disabled="{{busy || !nickname || !stores.length}}">创建测试客户并进入</button>
    </view>
    <view class="section-title">建议这样测试</view>
    <view class="card steps">
      <view>1. 客户 A：修改资料、给门店发消息、加载历史。</view>
      <view>2. 门店：查看客户、回复消息、处理注册提醒。</view>
      <view>3. 客户 B：检查不能看到客户 A 的私人会话。</view>
      <view>4. 管理员：管理门店、调整账户、维护服务和广告、查看记录。</view>
      <view class="muted">洗护下单、预约、支付和真实入口码尚不能在此演示。看到“筹备中”表示该功能仍待开发。</view>
    </view>
    <button class="secondary" bindtap="reset" disabled="{{busy}}">重置本机演示数据</button>
  </block>
  <button class="secondary" bindtap="realLogin" disabled="{{busy}}">进入云端登录 / 联调</button>
  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>
