.hero{background:#285c47;color:#f6f7e9;border-radius:30rpx;padding:36rpx;position:relative;overflow:hidden;margin-top:30rpx}.hero .eyebrow{color:#b7c5a9;font-size:17rpx}.hero-title{font-size:54rpx;font-weight:550;line-height:1.3;margin:26rpx 0}.hero-note{font-size:25rpx;color:#c4d2bc}.flower{position:absolute;right:18rpx;top:70rpx;font-size:250rpx;line-height:1;color:#ccd9a3;transform:rotate(12deg)}.hero-bottom{border-top:1rpx solid #50765a;margin-top:38rpx;padding-top:24rpx;font-size:23rpx;display:flex;justify-content:space-between}.service-grid{display:flex;flex-wrap:wrap;gap:20rpx;margin-bottom:22rpx}.service-card{width:calc(50% - 10rpx);padding:26rpx 22rpx;border-radius:24rpx}.laundry{background:#e7eeda}.house{background:#efe9df}.service-icon{background:#ffffff88;display:inline-block;padding:12rpx 20rpx;border-radius:18rpx;font-size:36rpx;margin-bottom:28rpx}.service-title{font-size:31rpx;font-weight:600;margin-bottom:8rpx}.service-card .muted{font-size:22rpx}.service-card .tag{margin-top:22rpx;background:#ffffff99}.contact-icon{font-size:44rpx;color:#79916b}
.banner-swiper{margin-top:30rpx;height:420rpx;border-radius:30rpx;overflow:hidden}.banner-slide{position:relative;width:100%;height:100%;background:linear-gradient(120deg,#3a6d54,#285c47)}.banner-media{position:absolute;left:0;top:0;width:100%;height:100%}.banner-overlay{position:absolute;left:0;right:0;bottom:0;padding:60rpx 32rpx 48rpx;background:linear-gradient(180deg,rgba(20,40,30,0),rgba(20,40,30,.55));color:#f6f7e9}.banner-slide.text-only .banner-overlay{background:none;padding:32rpx 32rpx 48rpx}.banner-title{font-size:34rpx;font-weight:600;text-shadow:0 2rpx 8rpx rgba(0,0,0,.25)}.banner-flag{display:inline-block;background:#f6f7e9;color:#285c47;font-size:19rpx;padding:5rpx 16rpx;border-radius:999rpx;margin-bottom:12rpx}.banner-note{font-size:24rpx;color:#e8efe2;margin-top:10rpx;line-height:1.5;text-shadow:0 2rpx 8rpx rgba(0,0,0,.25)}
.banner-skeleton{margin-top:30rpx;height:420rpx;border-radius:30rpx;background:#e9ece3;animation:skpulse 1.4s ease-in-out infinite}.service-card.skeleton{height:260rpx;background:#e9ece3;animation:skpulse 1.4s ease-in-out infinite}@keyframes skpulse{0%,100%{opacity:1}50%{opacity:.5}}
