.hero{background:#285c47;color:#f6f7e9;border-radius:30rpx;padding:36rpx;position:relative;overflow:hidden;margin-top:30rpx}.hero .eyebrow{color:#b7c5a9;font-size:17rpx}.hero-title{font-size:54rpx;font-weight:550;line-height:1.3;margin:26rpx 0}.hero-note{font-size:25rpx;color:#c4d2bc}.flower{position:absolute;right:18rpx;top:70rpx;font-size:250rpx;line-height:1;color:#ccd9a3;transform:rotate(12deg)}.hero-bottom{border-top:1rpx solid #50765a;margin-top:38rpx;padding-top:24rpx;font-size:23rpx;display:flex;justify-content:space-between}.service-grid{display:flex;gap:20rpx;margin-bottom:22rpx}.service-card{width:50%;padding:26rpx 22rpx;border-radius:24rpx}.laundry{background:#e7eeda}.house{background:#efe9df}.service-icon{background:#ffffff88;display:inline-block;padding:12rpx 20rpx;border-radius:18rpx;font-size:36rpx;margin-bottom:28rpx}.service-title{font-size:31rpx;font-weight:600;margin-bottom:8rpx}.service-card .muted{font-size:22rpx}.service-card .tag{margin-top:22rpx;background:#ffffff99}.contact-icon{font-size:44rpx;color:#79916b}
