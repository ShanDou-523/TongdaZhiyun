<view class="page"><demo-banner/><view class="row"><view class="eyebrow">园邻 / EVERYDAY, BETTER</view><view class="tag">{{(user.park === '其它' && user.parkDetail) ? '其它·' + user.parkDetail : (user.park || '园区生活')}}</view></view><view class="title">{{user.nickname || '你好'}}，<view></view>今天也轻松一点。</view><view class="subtitle">{{store.name || '你的园区生活伙伴'}}</view>
<view class="hero"><view class="eyebrow">A LITTLE HELP, A BETTER DAY</view><view class="hero-title">把时间留给<view></view>喜欢的生活。</view><view class="hero-note">从一件干净的衣服，<view></view>到一个舒适的家。</view><view class="flower">✳</view><view class="hero-bottom">园区生活服务，即将与你见面 <text>↗</text></view></view>
<view wx:if="{{loading}}" class="banner-skeleton"></view><swiper wx:if="{{banners.length}}" class="banner-swiper" autoplay="{{banners.length > 1}}" circular="{{banners.length > 1}}" indicator-dots="{{banners.length > 1}}" indicator-color="rgba(255,255,255,.4)" indicator-active-color="#ffffff" interval="4500" duration="400"><swiper-item wx:for="{{banners}}" wx:key="_id"><view class="banner-slide {{item.mediaType === 'image' || item.mediaType === 'video' ? '' : 'text-only'}}"><image wx:if="{{item.mediaType === 'image' && item.mediaUrl}}" class="banner-media" src="{{item.mediaUrl}}" mode="aspectFill"/><video wx:if="{{item.mediaType === 'video' && item.mediaUrl}}" class="banner-media" src="{{item.mediaUrl}}" objectFit="cover" autoplay muted loop show-mute-btn show-center-play-btn="{{false}}" show-fullscreen-btn="{{false}}" show-play-btn="{{false}}" enable-progress-gesture="{{false}}"></video><view class="banner-overlay"><view class="banner-flag">活动</view><view class="banner-title">{{item.title}}</view><view class="banner-note">{{item.subtitle}}</view></view></view></swiper-item></swiper>
<view class="section-title">为日常，多想一步</view><view class="service-grid" wx:if="{{services.length}}"><view class="service-card {{item.tone}}" wx:for="{{services}}" wx:key="_id" data-id="{{item._id}}" bindtap="consult"><view class="service-icon">{{item.icon}}</view><view class="service-title">{{item.name}}</view><view class="muted">{{item.description}}</view><view class="tag">去下单</view></view></view><view class="service-grid" wx:elif="{{loading}}"><view class="service-card skeleton"></view><view class="service-card skeleton"></view></view><view class="card" wx:else><view class="muted">服务正在筹备中，上新后会第一时间出现在这里。</view></view>
<view class="section-title">总有人，在你身边</view><view class="card"><view class="row"><view><view class="service-title">{{panel.title}}</view><view class="muted">{{panel.note}}</view></view><view class="contact-icon">↗</view></view><button wx:if="{{user.role === 'customer'}}" class="primary" bindtap="contact">发消息给门店</button><button wx:if="{{user.role === 'store'}}" class="primary" bindtap="staff">进入门店工作台</button><button wx:if="{{user.role === 'admin'}}" class="primary" bindtap="admin">进入管理中心</button></view>
<view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary small" bindtap="load">重试</button></view><view class="footer">小事有人管 · 生活有余闲</view></view>
