<view class="page"><view class="eyebrow">YOUR LITTLE CORNER</view><view class="title">我的园邻</view><view class="card"><view class="row"><view class="section-title" style="margin:0">{{user.nickname}}</view><view class="tag">{{roleName}}</view></view><view class="muted">{{user.phone}} · 已验证</view><view class="meta">{{store.name}}</view></view><view class="card"><view class="label">昵称</view><input class="field" value="{{nickname}}" maxlength="24" bindinput="input"/><view class="label">所在园区</view><picker range="{{parks}}" value="{{parkIndex}}" data-key="parkIndex" bindchange="select"><view class="field">{{parks[parkIndex]}} ⌄</view></picker><input wx:if="{{parks[parkIndex] === '其它'}}" class="field" placeholder="填写园区 / 楼栋（20字以内）" maxlength="20" value="{{parkDetail}}" data-key="parkDetail" bindinput="input" style="margin-top:16rpx"/><view class="label">性别</view><picker range="{{genders}}" value="{{genderIndex}}" data-key="genderIndex" bindchange="select"><view class="field">{{genders[genderIndex]}} ⌄</view></picker><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存资料</button></view><button class="secondary" wx:if="{{user.role === 'store'}}" bindtap="staff">门店工作台 →</button><button class="secondary" wx:if="{{user.role === 'admin'}}" bindtap="admin">管理中心 →</button><view class="error" wx:if="{{error}}">{{error}}</view><view class="link" bindtap="privacy">隐私说明</view><button class="secondary" bindtap="logout">退出登录</button></view>