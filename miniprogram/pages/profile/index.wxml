<view class="page"><view class="eyebrow">YOUR LITTLE CORNER</view><view class="title">我的园邻</view><view class="card"><view class="row"><view class="section-title" style="margin:0">{{user.nickname}}</view><view class="tag">{{roleName}}</view></view><view class="muted">{{user.phone}} · 账户绑定号码</view><view class="meta">{{store.name}}</view><view class="error" wx:if="{{store && !store.enabled}}" style="margin:16rpx 0 0">你所属的门店已停用，请在下方选择一家正常营业的门店。</view></view><view class="card"><view class="label">昵称</view><input class="field" value="{{nickname}}" maxlength="24" data-key="nickname" bindinput="input"/><view class="label">所在园区</view><picker range="{{parks}}" value="{{parkIndex}}" data-key="parkIndex" bindchange="select"><view class="field">{{parks[parkIndex]}} ⌄</view></picker><input wx:if="{{parks[parkIndex] === '其它'}}" class="field" placeholder="填写园区 / 楼栋（20字以内）" maxlength="20" value="{{parkDetail}}" data-key="parkDetail" bindinput="input" style="margin-top:16rpx"/><view class="label">宿舍号（选填）</view><input class="field" value="{{dormRoom}}" maxlength="20" placeholder="例如：3栋502 / A-502" data-key="dormRoom" bindinput="input"/><view class="label">性别</view><picker range="{{genders}}" value="{{genderIndex}}" data-key="genderIndex" bindchange="select"><view class="field">{{genders[genderIndex]}} ⌄</view></picker><block wx:if="{{user.role === 'customer'}}"><view class="label">服务门店</view><picker range="{{stores}}" range-key="name" value="{{storeIndex}}" bindchange="pickStore"><view class="field">{{storeMissing ? '选择一家营业中的门店' : store.name + '（点击更换）'}} ⌄</view></picker></block><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存资料</button></view><button class="secondary" wx:if="{{user.role === 'customer'}}" bindtap="orders">我的订单 →</button><button class="secondary" wx:if="{{user.role === 'customer'}}" bindtap="runner">{{user.runner && user.runner.status === 'approved' ? '接单大厅 →' : '成为飞毛腿 →'}}</button><button class="secondary" wx:if="{{user.role === 'store'}}" bindtap="staff">门店工作台 →</button><button class="secondary" wx:if="{{user.role === 'admin'}}" bindtap="admin">管理中心 →</button><view class="error" wx:if="{{error}}">{{error}}</view><view class="link" bindtap="privacy">隐私说明</view><button class="secondary" bindtap="logout">退出登录</button></view>
