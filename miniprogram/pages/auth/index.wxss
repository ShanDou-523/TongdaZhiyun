.brand{display:flex;gap:20rpx;align-items:center;margin:12rpx 0 42rpx}.brand-icon{width:84rpx;height:84rpx;border-radius:24rpx;background:#285c47;color:white;font-size:46rpx;text-align:center;line-height:84rpx}.brand-name{font-size:36rpx;font-weight:650}.intro{position:relative;overflow:hidden;background:#e6edda;border-radius:30rpx;padding:42rpx 34rpx;min-height:316rpx;margin-bottom:24rpx}.intro .title{position:relative;z-index:1;font-size:50rpx}.orbit{position:absolute;right:-100rpx;width:300rpx;height:300rpx;border:1rpx solid #9db59a;border-radius:50%;top:20rpx}.orbit-two{right:-70rpx;top:45rpx}.leaf{position:absolute;right:38rpx;top:122rpx;font-size:100rpx;color:#92aa85}.form .tabs{margin-top:0}.form{padding:28rpx}
