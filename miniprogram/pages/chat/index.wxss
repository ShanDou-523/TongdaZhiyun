.chat-page{height:100vh;display:flex;flex-direction:column}.chat-note{text-align:center;padding:20rpx;font-size:22rpx;color:#8b9589}.messages{height:0;flex:1;box-sizing:border-box;padding:0 24rpx}.message{margin:26rpx 0;display:flex;flex-direction:column;align-items:flex-start}.message.mine{align-items:flex-end}.bubble{max-width:85%;padding:22rpx 26rpx;background:white;border-radius:6rpx 24rpx 24rpx 24rpx;margin-top:8rpx;word-break:break-all;white-space:pre-wrap}.mine .bubble{background:#285c47;color:#fff;border-radius:24rpx 6rpx 24rpx 24rpx}.composer{background:#fff;padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom))}.composer .primary{margin:0;min-width:110rpx}.composer .field{width:0}
