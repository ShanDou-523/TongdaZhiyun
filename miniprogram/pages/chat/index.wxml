<view class="chat-page"><view class="chat-note">与所属门店直接对话 · 文字消息</view><scroll-view class="messages" scroll-y scroll-into-view="{{bottom}}"><button wx:if="{{more}}" class="secondary small" bindtap="older">查看更早消息</button><view wx:if="{{loading}}" class="loading">正在加载…</view><view class="empty" wx:if="{{!loading && !items.length}}">打个招呼吧，<view></view>有什么需要都可以告诉我们。</view><view wx:for="{{items}}" wx:key="_id" id="m{{item.seq}}" class="message {{item.mine ? 'mine' : ''}}"><view class="meta">{{item.senderRole === 'store' ? '门店' : '客户'}} · {{item.time}}</view><view class="bubble"><text selectable>{{item.content}}</text></view></view></scroll-view><view class="composer"><view class="error" wx:if="{{error}}">{{error}}</view><view class="row"><input class="field grow" value="{{content}}" maxlength="1000" placeholder="说点什么…" bindinput="input" bindconfirm="send" confirm-type="send" disabled="{{busy}}"/><button class="primary small" bindtap="send" loading="{{busy}}" disabled="{{busy || !content}}">发送</button></view></view></view>