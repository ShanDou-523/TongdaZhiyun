<view class="page"><view class="eyebrow">RUNNER HALL</view><view class="title">接单大厅</view><view class="subtitle">查看取送任务，当前暂免跑腿费。</view>
<view class="tabs"><view class="tab {{tab === 'pool' ? 'active' : ''}}" data-tab="pool" bindtap="tab">可接单 {{pool.length}}</view><view class="tab {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="tab">我接的单 {{mine.length}}</view></view>
<block wx:if="{{tab === 'pool'}}"><view class="card" wx:for="{{pool}}" wx:key="_id"><view class="row"><view class="service-title">{{item.serviceName}}</view><view class="tag">{{item.feeText}}</view></view><view class="muted">{{item.items}}</view><view class="meta">取件：{{item.park}}{{item.parkDetail ? ' · ' + item.parkDetail : ''}}</view><view class="meta">{{item.customerName}} · {{item.time}}</view><button class="primary" data-id="{{item._id}}" bindtap="take" loading="{{busy}}" disabled="{{busy}}">接这一单</button></view><view class="empty" wx:if="{{!loading && !pool.length}}">现在没有待接的单子<view></view>等同学下单，这里会实时出现。</view></block>
<block wx:else><view class="card" wx:for="{{mine}}" wx:key="_id"><view class="row"><view class="service-title">{{item.serviceName}}</view><view class="tag">{{item.statusText}}</view></view><view class="muted">{{item.items}}</view><view class="meta">取件：{{item.park}}{{item.parkDetail ? ' · ' + item.parkDetail : ''}}</view><view class="meta">联系电话：{{item.contact}}</view><view class="meta">{{item.customerName}} · {{item.time}} · {{item.feeText}}</view><button wx:if="{{item.canPick}}" class="primary" data-id="{{item._id}}" data-step="picked" bindtap="advance" loading="{{busy}}" disabled="{{busy}}">我已取件</button><button wx:if="{{item.canDeliver}}" class="primary" data-id="{{item._id}}" data-step="delivered" bindtap="advance" loading="{{busy}}" disabled="{{busy}}">已送到门店</button></view><view class="empty" wx:if="{{!loading && !mine.length}}">还没有接过单<view></view>去左边看看有没有顺路的。</view></block>
<view class="error" wx:if="{{error}}">{{error}}</view><view class="loading" wx:if="{{loading}}">正在加载…</view></view>
