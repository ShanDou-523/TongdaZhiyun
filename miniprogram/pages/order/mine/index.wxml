<view class="page"><view class="eyebrow">MY ORDERS</view><view class="title">{{staff ? '门店订单' : '我的订单'}}</view><view class="subtitle">每一单都能看到进度。</view>
<button wx:if="{{!staff}}" class="primary" bindtap="create">＋ 再下一单</button>
<view class="card" wx:for="{{items}}" wx:key="_id"><view class="row"><view class="service-title">{{item.serviceName}}</view><view class="tag">{{item.statusText}}</view></view><view class="muted">{{item.items}}</view><view class="meta" wx:if="{{item.variantName}}">{{item.variantName}} · {{item.quantity}}{{item.unit}} · 基础服务金额 {{item.amountText}}元</view><view class="meta" wx:if="{{item.serviceAmount === undefined}}">{{item.quantity || 1}}{{item.unit || '件'}} · 待门店报价</view><view class="meta" wx:if="{{item.appointment}}">预约上门：{{item.appointment}}</view><view class="meta" wx:if="{{item.note}}">备注：{{item.note}}</view><view class="meta" wx:if="{{staff}}">客户：{{item.customerName}} · {{item.contact}}</view><view class="meta">地址：{{item.park}}{{item.parkDetail ? ' · ' + item.parkDetail : ''}}</view><view class="row"><view class="meta">{{item.time}}</view><view class="meta">{{item.delivery === 'onsite' ? '家政上门' : (item.delivery === 'runner' ? '飞毛腿 · ' + item.feeText : '自己送')}}</view></view><view class="meta" wx:if="{{item.runnerName}}">骑手：{{item.runnerName}}</view><button wx:if="{{staff && item.canAccept}}" class="primary" data-id="{{item._id}}" data-action="order.accept" bindtap="advance" disabled="{{busy}}">确认接单</button><button wx:if="{{staff && item.status === 'serving'}}" class="primary" data-id="{{item._id}}" data-action="order.finish" bindtap="advance" disabled="{{busy}}">完成服务</button><button wx:if="{{item.canCancel}}" class="secondary small" data-id="{{item._id}}" bindtap="cancel">取消订单</button></view>
<view class="empty" wx:if="{{!loading && !items.length}}">还没有订单<view></view>点上面的按钮，把要处理的东西交给我们。</view>
<button wx:if="{{more}}" class="secondary" bindtap="load">加载更多</button><view class="loading" wx:if="{{loading}}">正在加载…</view><view class="error" wx:if="{{error}}">{{error}}</view></view>
