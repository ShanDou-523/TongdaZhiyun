page{background:#f6f7f2;color:#233e32;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.55}
view,text,input,textarea,button{box-sizing:border-box} .page{padding:36rpx 32rpx calc(48rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#7b8c80;font-weight:600}.title{font-size:48rpx;font-weight:650;letter-spacing:-1rpx;line-height:1.25;margin:12rpx 0 20rpx}.subtitle,.muted{color:#7f8b82;font-size:25rpx}.section-title{font-size:32rpx;font-weight:600;margin:36rpx 0 20rpx}.card{background:#fff;border:1rpx solid #e7ebe2;border-radius:26rpx;padding:30rpx;margin-bottom:20rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.grow{flex:1;min-width:0}.tag{display:inline-block;font-size:21rpx;background:#edf3e8;color:#42604b;border-radius:12rpx;padding:6rpx 14rpx}.dot{width:16rpx;height:16rpx;background:#d58a54;border-radius:50%;flex-shrink:0}.label{font-size:24rpx;color:#66756a;margin:22rpx 0 10rpx}.field{background:#f6f7f2;border:1rpx solid #e2e7dc;border-radius:14rpx;padding:22rpx 24rpx;min-height:88rpx;width:100%}input.field{height:92rpx}.primary{background:#285c47!important;color:#fff!important;border-radius:16rpx;font-size:28rpx;font-weight:600;padding:8rpx 0;margin:26rpx 0 0}.secondary{background:#edf1e7;color:#35513e;border-radius:14rpx;font-size:26rpx;margin:18rpx 0 0}.small{font-size:23rpx;padding:0 20rpx;line-height:64rpx;margin:0;width:auto}.danger{color:#a1503b}.error{background:#fff0e9;color:#9a4f39;padding:20rpx;border-radius:14rpx;font-size:25rpx;margin:18rpx 0;word-break:break-all}.empty{padding:60rpx 24rpx;text-align:center;color:#829084}.link{color:#36694e;font-size:25rpx;padding:14rpx 0}.tabs{display:flex;gap:14rpx;flex-wrap:wrap;margin:24rpx 0}.tab{padding:14rpx 22rpx;background:#e9eee3;border-radius:14rpx;font-size:25rpx}.tab.active{background:#285c47;color:white}.divider{height:1rpx;background:#eef0e9;margin:22rpx 0}.meta{font-size:22rpx;color:#8b958d}.loading{color:#7b8b7e;padding:20rpx;text-align:center}button::after{border:0}button[disabled]{opacity:.5}.stack{display:flex;flex-direction:column;gap:8rpx}.mono{font-family:monospace;font-size:22rpx;word-break:break-all;white-space:pre-wrap}.badge{background:#fff0dc;color:#997039;padding:6rpx 14rpx;border-radius:10rpx;font-size:22rpx}.check{display:flex;align-items:flex-start;gap:12rpx;font-size:24rpx;margin:24rpx 0;color:#6a7e6e}.footer{color:#95a091;text-align:center;font-size:20rpx;letter-spacing:3rpx;padding-top:36rpx}.truncate{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
